---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToyCard from '../../components/ToyCard.astro';

const toys = await getCollection('toys');
---

<BaseLayout
  title="Toys — Field Notes"
  description="Small apps built with AI. Each one has a colophon: stack, build time, one honest limitation."
>
  <h1>Toys</h1>
  <p>
    Small apps built with AI. They earn their place by existing, not by being
    impressive. Each one gets a colophon: stack, build time, one honest
    limitation.
  </p>
  {toys.map((toy) => <ToyCard toy={toy} />)}
</BaseLayout>
