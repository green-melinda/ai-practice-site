---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('process')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Process — Field Notes"
  description="Essays about judgment: where AI fit, where it didn't, and what got rejected along the way."
>
  <h1>Process</h1>
  <p>
    Essays about judgment. Each one shows where AI fit, where it didn't, and
    what was kept, rejected, and why.
  </p>
  <ul>
    {
      entries.map((entry) => (
        <li>
          <a href={`/process/${entry.id}/`}>{entry.data.title}</a>
          <p>{entry.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
