---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToyCard from '../components/ToyCard.astro';

const entries = (await getCollection('process')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const toys = await getCollection('toys');
---

<BaseLayout
  title="AI practice — Melinda Green"
  description="A designer's field notes on working with AI — showing the judgment, not just the output."
>
  <h1>AI practice</h1>
  <p>
    A designer's field notes on working with AI — showing the judgment, not
    just the output.
  </p>
  <!-- Home intro (the thesis, stated once, plainly) gets written Thursday, last. -->

  <section aria-labelledby="process-heading">
    <h2 id="process-heading">Process</h2>
    <ul>
      {
        entries.map((entry) => (
          <li>
            <a href={`/process/${entry.id}/`}>{entry.data.title}</a>
          </li>
        ))
      }
    </ul>
    <p><a href="/process/">All process entries</a></p>
  </section>

  <section aria-labelledby="toys-heading">
    <h2 id="toys-heading">Toys</h2>
    {toys.map((toy) => <ToyCard toy={toy} />)}
    <p><a href="/toys/">The full shelf</a></p>
  </section>

  <section aria-labelledby="about-heading">
    <h2 id="about-heading">About</h2>
    <p>
      Who I am, how I work, and what I'm looking for.
      <a href="/about/">Read the operating manual</a>.
    </p>
  </section>
</BaseLayout>
