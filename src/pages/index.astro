---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// One app, one story, one colophon, one page (2026-08-05). Routes exist to
// disambiguate multiple items; with a single artifact there is nothing to
// disambiguate, so /process/ and /toys/ retired. The collection stays, so a
// second artifact grows this page into a shelf without a rewrite.
const entries = await getCollection('process');
const entry = entries.find((e) => e.data.app) ?? entries[0];
const { Content } = await render(entry);
const { title, rejected, limitation, stack, buildTime, app } = entry.data;
---

<BaseLayout
  title="Field Notes — Melinda Green"
  description="Working things I've built with AI — and the judgment that shaped them."
>
  <article>
    {/* The artifact leads: touch something working before reading about it. */}
    <div class="toy-card">
      <h1>{title}</h1>
      <p class="toy-dek">Tell it how you feel. It tells you what to watch.</p>
      <a class="btn-try" href={app}>Try it</a>
    </div>

    <section class="story" aria-labelledby="story-heading">
      <h2 id="story-heading">I'm a movie person.</h2>
      <Content />
    </section>

    <section class="confession" aria-labelledby="confession-heading">
      <h2 id="confession-heading">It made me feel a little dirty.</h2>
      <dl>
        <div class="row">
          <dt>What I rejected</dt>
          <dd>{rejected}</dd>
        </div>
        {
          limitation && (
            <div class="row">
              <dt>What it can't do yet</dt>
              <dd>
                <ul>
                  {limitation.map((l) => (
                    <li>{l}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        {
          stack && (
            <div class="row">
              <dt>Stack</dt>
              <dd>
                <ul>
                  {stack.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        {
          buildTime && (
            <div class="row">
              <dt>Build time</dt>
              <dd>{buildTime}</dd>
            </div>
          )
        }
      </dl>
    </section>
  </article>

  <footer class="home-footer" slot="footer">
    <p><a href="https://www.mynameisgreenmelinda.com">Melinda Green</a></p>
    <p>Built with Civic Ink v1.6</p>
  </footer>
</BaseLayout>

<style>
  /* This page's styles ship only with this page. */
  :global(main) {
    padding-block: var(--space-5) var(--space-7);
  }

  /* ---- The artifact ---- */
  .toy-card {
    /* Blue Hour "Twilight" surface — values from find-a-film
       public/tokens.css (dark mode). The toy keeps its own palette;
       the card is dark in both site modes. */
    --toy-ground: #0e1228;
    --toy-text: #e8e4f0;
    --toy-text-soft: #8b8db0;

    background: var(--toy-ground);
    border: var(--border-mid);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
  }

  /* The card title is now the page h1 — Syne is the toy's voice, confined
     to this card (Civic Ink v1.6), so it overrides the global display face. */
  .toy-card h1 {
    font-family: 'Syne', 'Helvetica Neue', 'Helvetica', sans-serif;
    font-size: var(--text-body-xl);
    line-height: 32px;
    font-weight: 600;
    letter-spacing: var(--tracking-normal);
    color: var(--toy-text);
    margin: var(--space-2) 0 0;
  }

  .toy-dek {
    font-size: var(--text-body-sm);
    line-height: 24px;
    color: var(--toy-text-soft);
    max-width: 42ch;
    margin: var(--space-1) 0 0;
  }

  .btn-try {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* WCAG touch-target floor, deliberately off-grid */
    margin-top: var(--space-3);
    padding: 0 var(--space-3);
    background: var(--color-acid);
    color: var(--color-ink);
    border: var(--border-mid);
    border-radius: var(--radius-sm);
    font-size: var(--text-body-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .btn-try:hover {
    /* "Slight darken of Acid" per spec — derived, not a new token. */
    filter: brightness(0.92);
  }

  /* ---- The story ---- */
  .story {
    margin-top: var(--space-6);
  }

  .story h2 {
    margin: 0 0 var(--space-4);
  }

  /* <Content /> renders markdown, so its paragraphs need :global to be
     reachable from this component's scoped styles. */
  .story :global(p) {
    margin: 0 0 var(--space-4);
  }

  .story :global(p:last-child) {
    margin-bottom: 0;
  }

  /* ---- The confession ---- */
  /* The site's spine gets a rule above it and nothing else: hairlines and
     type, per the editorial-brutalism note in CLAUDE.md. */
  .confession {
    margin-top: var(--space-6);
    border-top: var(--border-mid);
    padding-top: var(--space-4);
  }

  .confession h2 {
    margin: 0 0 var(--space-4);
  }

  .confession dl {
    margin: 0;
  }

  .confession .row {
    display: grid;
    /* Wide enough that "What it can't do yet" holds one line — the label is
       honest copy and doesn't get shortened to suit the column. */
    grid-template-columns: 200px 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: var(--border-rule);
  }

  .confession .row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .confession dt {
    font-size: var(--text-body-xs);
    line-height: 24px;
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-charcoal);
  }

  .confession dd {
    margin: 0;
    font-size: var(--text-body-sm);
    line-height: 24px;
  }

  .confession dd ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .confession dd li + li {
    margin-top: var(--space-2);
  }

  /* ---- Footer ---- */
  .home-footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    border-top: var(--border-mid);
    padding-block: var(--space-3);
    font-size: var(--text-body-xs);
    color: var(--color-charcoal);
  }

  .home-footer p {
    margin: 0;
  }

  .home-footer a {
    color: inherit;
  }

  .home-footer a:hover {
    color: var(--color-cobalt);
  }

  /* ---- Responsive ---- */
  @media (max-width: 767px) {
    /* The label column can't hold its width and the measure at once. */
    .confession .row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
