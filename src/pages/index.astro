---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToyCard from '../components/ToyCard.astro';

const entries = (await getCollection('process')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const toys = await getCollection('toys');
---

<BaseLayout
  title="Field Notes — Melinda Green"
  description="Working things I've built with AI — and the judgment that shaped them."
>
  <h1 class="hero">Field Notes</h1>
  <p>Working things I've built with AI — and the judgment that shaped them.</p>
  <!-- Home intro (the thesis, stated once, plainly) gets written Thursday, last. -->

  <section aria-labelledby="toys-heading">
    <h2 id="toys-heading">Toys</h2>
    {toys.map((toy) => <ToyCard toy={toy} />)}
    <p><a href="/toys/">The full shelf</a></p>
  </section>

  <section aria-labelledby="process-heading">
    <h2 id="process-heading">Process</h2>
    <ul>
      {
        entries.map((entry) => (
          <li>
            <a href={`/process/${entry.id}/`}>{entry.data.title}</a>
          </li>
        ))
      }
    </ul>
    <p><a href="/process/">All process entries</a></p>
  </section>

  <section aria-labelledby="about-heading">
    <h2 id="about-heading">About</h2>
    <p>
      Who I am, how I work, and what I'm looking for.
      <a href="/about/">Read the operating manual</a>.
    </p>
  </section>
</BaseLayout>

<style>
  /* The one earned display-xl moment: the site's name on its own page.
     Steps down one token below --bp-sm so it holds one line. */
  .hero {
    font-size: var(--text-display-xl);
  }

  @media (max-width: 480px) {
    .hero {
      font-size: var(--text-display-lg);
    }
  }
</style>
