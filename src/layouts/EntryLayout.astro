---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  /** Live URL of the app this entry is about, when there is one. */
  app?: string;
}

const { title, description, date, app } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      {
        date && (
          <time datetime={date.toISOString().slice(0, 10)}>
            {date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              // Frontmatter dates parse as UTC midnight; render them in
              // UTC too or the day shifts back one in western timezones.
              timeZone: 'UTC',
            })}
          </time>
        )
      }
      {app && <a class="app-link" href={app}>Try the app</a>}
    </header>
    <slot />
  </article>
</BaseLayout>

<style>
  /* Entry-page spec (2026-07-16, logged in docs/decisions.md): one
     flush-left column; title, metadata, and prose share the left edge.
     The measure comes from the global one-column rule on main. */
  article > header {
    margin-bottom: var(--space-5);
  }

  h1 {
    margin: 0;
  }

  /* Date and app link are chrome, not voice: Instrument Sans metadata
     on one line under the title. */
  time,
  .app-link {
    font-size: var(--text-body-sm);
    color: var(--color-charcoal);
  }

  time {
    display: inline-block;
    margin-top: var(--space-2);
  }

  .app-link {
    margin-left: var(--space-3);
  }

  .app-link:hover {
    color: var(--color-cobalt);
  }
</style>
