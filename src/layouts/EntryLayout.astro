---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date?: Date;
}

const { title, description, date } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      {
        date && (
          <time datetime={date.toISOString().slice(0, 10)}>
            {date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              // Frontmatter dates parse as UTC midnight; render them in
              // UTC too or the day shifts back one in western timezones.
              timeZone: 'UTC',
            })}
          </time>
        )
      }
    </header>
    <slot />
  </article>
</BaseLayout>
